{
  "name": "xiaomao-share",
  "version": "2.1.0",
  "private": true,
  "description": "XiaoMao 互传 —— 局域网内文字 / 图片 / 文件互传，零依赖",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js --open",
    "serve": "node server.js",
    "desktop": "node desktop/run.js",
    "dist": "electron-builder"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "cc.xiaomao.share",
    "productName": "XiaoMao 互传",
    "artifactName": "XiaoMaoShare-${version}-${os}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "xiaomaoJT",
      "repo": "XiaoMaoShare"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "server.js",
      "public/**",
      "desktop/**",
      "package.json"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
