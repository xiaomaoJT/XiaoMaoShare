{
  "name": "xiaomao-share",
  "version": "2.2.4",
  "private": true,
  "description": "XiaoMao 互传 —— 局域网内文字 / 图片 / 文件互传，零依赖",
  "author": "XiaoMaoShare <895250757@qq.com>",
  "license": "MIT",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js --open",
    "serve": "node server.js",
    "desktop": "node desktop/run.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64 --publish never && node build/make-portable-zip.mjs",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:all": "npm run dist:win && npm run dist:mac"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "jimp": "^0.22.12",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "cc.xiaomao.share",
    "productName": "XiaoMao 互传",
    "artifactName": "XiaoMaoShare-${version}-${os}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "xiaomaoJT",
      "repo": "XiaoMaoShare"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "server.js",
      "public/**",
      "desktop/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "XiaoMaoShare-${version}-win-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
